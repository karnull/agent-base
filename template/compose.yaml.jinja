# devenv moves this file and its .env out of the project, so nothing in a container
# can change what the host runs; every path comes from the absolute PROJECT_ROOT
name: ${PROJECT_SLUG:?missing from .env}-agent

services:
  agent:
    container_name: ${PROJECT_SLUG}
    hostname: ${PROJECT_SLUG}
    build:
      context: ${PROJECT_ROOT:?missing from .env}/.shard
      dockerfile: Dockerfile
    image: ${PROJECT_SLUG}-agent:latest
    pull_policy: build
    init: true
    restart: unless-stopped
    stdin_open: true
    tty: true

    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true

    working_dir: ${PROJECT_ROOT:?missing from .env}/main
    environment:
      PROJECT_ROOT: ${PROJECT_ROOT}
      # the character signs every commit made in this container, or a plain agent when there is none
{%- if character %}
      GIT_AUTHOR_NAME: ${CHARACTER}
      GIT_AUTHOR_EMAIL: ${CHARACTER_SLUG}@kargent.local
      GIT_COMMITTER_NAME: ${CHARACTER}
      GIT_COMMITTER_EMAIL: ${CHARACTER_SLUG}@kargent.local
{%- else %}
      GIT_AUTHOR_NAME: agent
      GIT_AUTHOR_EMAIL: agent@kargent.local
      GIT_COMMITTER_NAME: agent
      GIT_COMMITTER_EMAIL: agent@kargent.local
{%- endif %}

    # optional: CLAUDE_CODE_OAUTH_TOKEN for every container, kept in one file on the host
    env_file:
      - path: ${HOME}/.local/share/blackwall/claude.env
        required: false

    # each container has its own claude folder; the shared one is read-only, so none can plant a hook in another
    volumes:
      - ${PROJECT_ROOT}:${PROJECT_ROOT}
      - ${HOME}/.local/share/blackwall/cages/${PROJECT_SLUG}/claude:/home/dev/.claude
      - ${HOME}/.local/share/blackwall/claude/managed:/etc/claude-code:ro
      - ${HOME}/.local/share/blackwall/claude/skills:/home/dev/.claude/skills:ro
      - ${HOME}/.config/gh:/home/dev/.config/gh
