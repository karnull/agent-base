{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests",
    ":semanticCommitScopeDisabled"
  ],
  "timezone": "Australia/Melbourne",
  "schedule": ["before 6am on sunday"],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "dependencyDashboard": true,
  "automerge": false,
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "packageRules": [
    {
      "description": "agent-base is built locally on each machine and never published",
      "matchPackageNames": ["agent-base"],
      "enabled": false
    },
    {
      "description": "python stays on the 3.14 series; moving to a new series is a deliberate choice, not an update",
      "matchDepNames": ["python"],
      "allowedVersions": "<3.15"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "versions marked with a renovate comment on the line above",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/",
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\s+(?:ARG |ENV )?[\\w-]+[:=] *\"?(?<currentValue>[^\\s\"@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?\"?"
      ]
    }
  ]
}
